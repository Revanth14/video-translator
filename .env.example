# Web app mode. Use local for laptop tests, queued when a GPU worker consumes jobs.
VIDEO_TRANSLATOR_RUNNER=queued

# Shared run directory visible to the web process and GPU worker.
VIDEO_TRANSLATOR_RUNS=/srv/video-translator/runs

# Web server bind for a demo box behind a firewall or reverse proxy.
VIDEO_TRANSLATOR_HOST=0.0.0.0
VIDEO_TRANSLATOR_PORT=8787

# Worker polling interval in seconds.
VIDEO_TRANSLATOR_WORKER_POLL_SECONDS=5

# Translation provider credentials.
OPENAI_API_KEY=
VIDEO_TRANSLATOR_TRANSLATOR_MODEL=gpt-5-mini
# Optional pricing snapshot used to estimate translation cost from token usage.
# Set these to the rates for the selected model; leaving them blank records
# tokens with cost_status=pricing_unavailable instead of inventing a price.
VIDEO_TRANSLATOR_OPENAI_INPUT_USD_PER_MILLION=
VIDEO_TRANSLATOR_OPENAI_OUTPUT_USD_PER_MILLION=

# Speech/transcription provider placeholders.
WHISPERX_MODEL=large-v3
INDICF5_MODEL=ai4bharat/IndicF5
HF_TOKEN=

# Optional CUDA/PyTorch runtime hints for the GPU droplet.
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
